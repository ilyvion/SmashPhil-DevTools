<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Smash Phil</Authors>
    <Description>SDK for benchmarking and unit testing in RimWorld.</Description>
    <Product>DevTools</Product>
    <RootNamespace>DevTools</RootNamespace>
    <AssemblyName>DevTools</AssemblyName>

    <OutDir>$(ModDir)\$(RimWorldVersion)\Assemblies\</OutDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RimWorldVersion)' == '1.6' ">
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);v1_6</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(RimWorldVersion)' == '1.7' ">
    <DefineConstants>$(DefineConstants);v1_7</DefineConstants>
  </PropertyGroup>

  <!--
    The test manifest and TCP result stream need System.Text.Json, TestMessage needs init accessors,
    and ScopedRollback needs ref fields, so all are 1.7 only
  -->
  <ItemGroup Condition=" '$(RimWorldVersion)' == '1.6' ">
    <Compile Remove="Testing/DataWriter.cs;Testing/IJsonSerializable.cs;Testing/TestMessage.cs;Testing/Test/TcpBridge.cs;Generated/ScopedRollback.cs" />
  </ItemGroup>

  <!-- Harmony is kept private so it doesn't flow into projects referencing DevTools, which bring their own -->
  <ItemGroup Condition=" '$(RimWorldVersion)' == '1.6' ">
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition=" '$(RimWorldVersion)' == '1.7' ">
    <PackageReference Include="Lib.Harmony" Version="3.0.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6' AND '$(AnalyzerProject)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7' AND '$(AnalyzerProject)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images/Icon_TestPassed.png" />
    <EmbeddedResource Include="Images/Icon_TestFailed.png" />
    <EmbeddedResource Include="Images/Icon_TestRunning.png" />
    <EmbeddedResource Include="Images/Icon_TestCanceled.png" />
    <EmbeddedResource Include="Images/Icon_TestNotRan.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Generated\" />
  </ItemGroup>
</Project>
